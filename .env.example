# Bloom RCM environment configuration
# Copy to .env.local for local development. Never commit real credentials.

# Preferred production database variable (Neon pooled connection URL)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# Optional local/alternative PostgreSQL connection
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Public deployed URL (canonical links, sitemap, password resets)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional transactional email via Resend
RESEND_API_KEY=
EMAIL_FROM=inquiries@your-domain.com
